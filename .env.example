# Runtime
NODE_ENV=development
PORT=8787

# SQLite (WAL enabled on connect). Relative paths resolve against apps/api cwd.
SQLITE_PATH=../../data/inbound.sqlite
MIGRATIONS_PATH=drizzle

# Public URLs (12-factor)
API_URL=http://localhost:8787
BIO_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

# Dashboard / bio Vite
VITE_API_URL=http://localhost:8787
VITE_BIO_URL=http://localhost:3001

# WorkOS AuthKit
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_PRICE_YEARLY_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PRICE_YEARLY_ID=

# Resend (send-only; no webhook)
RESEND_API_KEY=
SUPPORT_EMAIL=
SALES_EMAIL=
FEEDBACK_EMAIL=

# Backblaze B2 (S3-compatible)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=bucket-name
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PUBLIC_URL=https://f004.backblazeb2.com/file/bucket-name

# Tinybird (local: http://localhost:7181 + token from `tb token copy "admin local_testing@tinybird.co"`)
TINYBIRD_URL=
TINYBIRD_TOKEN=

# AI agents
OPENAI_API_KEY=

# Internal HTTP cron (Railway Cron service curls the API; required in all envs)
CRON_SECRET=dev-cron-secret
