{
  "name": "@inbound/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "stripe-tunnel": "ngrok http 8787 --domain=factual-worm-mostly.ngrok-free.app",
    "tb:start": "./tb_start.sh",
    "tinybird:dev": "tinybird dev",
    "tinybird:build": "tinybird build",
    "tinybird:deploy": "tinybird deploy",
    "tinybird:preview": "tinybird preview"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.7.6",
    "@inbound/shared": "workspace:*",
    "@tinybirdco/sdk": "^0.0.55",
    "@toon-format/toon": "^4.1.0",
    "@workos-inc/node": "^7.71.0",
    "ai": "^6.0.116",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.7",
    "resend": "^4.4.1",
    "stripe": "^18.0.0",
    "uuid": "^13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inbound/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.3",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
