{
  "name": "@inbound/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "node dist/migrate.js && node dist/index.js",
    "build": "tsup",
    "release": "tinybird deploy && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && tsx src/scripts/check-migration-drift.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "stripe-tunnel": "ngrok http 8787 --domain=factual-worm-mostly.ngrok-free.app",
    "tb:start": "./tb_start.sh",
    "tinybird:dev": "tinybird dev",
    "tinybird:build": "tinybird build",
    "tinybird:deploy": "tinybird deploy",
    "tinybird:preview": "tinybird preview"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.9.1",
    "@inbound/shared": "workspace:*",
    "@tinybirdco/sdk": "^0.0.84",
    "@toon-format/toon": "^4.4.0",
    "@workos-inc/node": "^7.71.0",
    "ai": "^6.0.116",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "resend": "^6.35.0",
    "stripe": "^18.0.0",
    "uuid": "^13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inbound/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
