# Used by the Tinybird CLI (next to tinybird.config.json).
# Also keep the same values in the repo root .env.local for the API runtime.
TINYBIRD_URL=http://localhost:7181
TINYBIRD_TOKEN=

# Playwright (`pnpm e2e`). Staging WorkOS user. The API does not read these.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
