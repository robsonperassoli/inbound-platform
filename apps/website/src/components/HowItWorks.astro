---
const steps = [
  {
    number: '1',
    color: 'coral',
    title: 'Connect your world',
    body: 'Add your essential links and social handles, then connect your custom domain (s.uper.bio/yourbrand) for a seamless, on-brand experience.',
  },
  {
    number: '2',
    color: 'yellow',
    title: 'Tell the AI what you need',
    body: '"Collect names, emails, phone numbers, budget, etc." No drag-and-drop, no coding. The AI architects a high-converting capture flow in seconds.',
  },
  {
    number: '3',
    color: 'mint',
    title: 'Share & relax',
    body: 'Paste your link across Instagram, TikTok, LinkedIn, and YouTube. We handle the capture and route every lead straight into your workflow.',
  },
];
---

<section class="section" id="how-it-works">
  <div class="container">
    <p class="eyebrow">How it works</p>
    <h2 class="section-title">Easy as one, two, three.</h2>
    <p class="section-lede">
      We bridge the gap between audience discovery and lead generation by
      making data capture frictionless for you and your followers.
    </p>

    <ol class="steps">
      {
        steps.map((step) => (
          <li class={`step step-${step.color}`}>
            <span class="step-number" aria-hidden="true">
              {step.number}
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .step {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .step:hover {
    transform: translateY(-4px);
  }

  .step-coral:hover {
    box-shadow: 0 16px 40px -16px color-mix(in srgb, var(--coral) 50%, transparent);
  }

  .step-yellow:hover {
    box-shadow: 0 16px 40px -16px color-mix(in srgb, var(--yellow) 60%, transparent);
  }

  .step-mint:hover {
    box-shadow: 0 16px 40px -16px color-mix(in srgb, var(--mint) 55%, transparent);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .step-coral .step-number {
    background: var(--coral);
    color: var(--white);
  }

  .step-yellow .step-number {
    background: var(--yellow);
    color: var(--ink);
  }

  .step-mint .step-number {
    background: var(--mint);
    color: var(--ink);
  }

  .step h3 {
    font-size: 1.5rem;
    margin-top: 1.5rem;
  }

  .step p {
    margin-top: 0.875rem;
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
