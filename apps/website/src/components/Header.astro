---
import { APP_SIGNIN_URL } from '../consts';
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Inbound.click home">
      <img src="/logo.svg" alt="Inbound.click" width="182" height="25" />
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/#how-it-works">How it works</a>
      <a href="/#features">Features</a>
      <a href="/#pricing">Pricing</a>
      <a href="/#contact">Contact</a>
    </nav>
    <div class="header-actions">
      <a href={APP_SIGNIN_URL} class="login">Log in</a>
      <a href={APP_SIGNIN_URL} class="btn btn-primary btn-sm">Get started</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 4.5rem;
  }

  .brand img {
    height: 22px;
    width: auto;
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav a {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .login {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .login:hover {
    color: var(--ink);
  }

  .btn-sm {
    padding: 0.55rem 1.25rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 720px) {
    .nav,
    .login {
      display: none;
    }
  }
</style>
