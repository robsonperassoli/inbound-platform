---
const features = [
  {
    color: 'coral',
    title: 'Conversational capture',
    body: 'Drop-off rates plummet when forms feel like a chat. Followers reply via text or voice audio instead of filling out rigid web forms.',
    icon: 'chat',
  },
  {
    color: 'yellow',
    title: 'AI form architect',
    body: 'You just talk to our agent and it builds the form in seconds, not hours, so you can focus on your business.',
    icon: 'spark',
  },
  {
    color: 'mint',
    title: 'Speed-to-lead alerts',
    body: "Don't let prospects go cold. Get notified via SMS, WhatsApp, or email the moment a qualified lead lands.",
    icon: 'bolt',
  },
  {
    color: 'mint',
    title: 'Clicks & conversion analytics',
    body: 'Track clicks, views, and conversions in a clean, organized dashboard of every lead you capture.',
    icon: 'chart',
  },
  {
    color: 'coral',
    title: 'Universal integrations',
    body: 'Route leads directly into HubSpot, Salesforce, your inbox, or thousands of other tools via native webhooks.',
    icon: 'plug',
  },
  {
    color: 'yellow',
    title: 'Bring your own domain',
    body: 'Maintain absolute brand authority with your own domain instead of a generic hosted link.',
    icon: 'globe',
  },
];

const icons: Record<string, string> = {
  chat: 'M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1Z',
  spark: 'M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2Z',
  bolt: 'M13 2 4 14h6l-1 8 9-12h-6l1-8Z',
  chart: 'M4 20V10m6 10V4m6 16v-7m4 7H2',
  plug: 'M9 7V3m6 4V3M7 7h10v4a5 5 0 0 1-5 5 5 5 0 0 1-5-5V7Zm5 9v5',
  globe:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 0c3 3.5 3 14.5 0 20m0-20c-3 3.5-3 14.5 0 20M2.5 9h19M2.5 15h19',
};
---

<section class="section features" id="features">
  <div class="container">
    <p class="eyebrow">Features</p>
    <h2 class="section-title">Everything you need to turn traffic into leads.</h2>
    <p class="section-lede">
      Built for creators, agency owners, real estate agents, coaches, and
      consultants who live on social and want a real pipeline out of it.
    </p>

    <div class="grid">
      {
        features.map((feature) => (
          <article class={`card card-${feature.color}`}>
            <span class="icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="26"
                height="26"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={icons[feature.icon]} />
              </svg>
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--ink);
    color: var(--cream);
  }

  .features .eyebrow {
    color: color-mix(in srgb, var(--cream) 70%, transparent);
  }

  .features .section-lede {
    color: color-mix(in srgb, var(--cream) 65%, transparent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 4rem;
  }

  .card {
    background: color-mix(in srgb, var(--cream) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--cream) 12%, transparent);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    background: color-mix(in srgb, var(--cream) 9%, transparent);
    transform: translateY(-4px);
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-md);
  }

  .card-coral .icon {
    background: var(--coral);
    color: var(--white);
  }

  .card-yellow .icon {
    background: var(--yellow);
    color: var(--ink);
  }

  .card-mint .icon {
    background: var(--mint);
    color: var(--ink);
  }

  .card h3 {
    font-size: 1.375rem;
    margin-top: 1.5rem;
  }

  .card p {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: color-mix(in srgb, var(--cream) 68%, transparent);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
