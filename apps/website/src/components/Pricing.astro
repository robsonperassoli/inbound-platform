---
import { APP_SIGNIN_URL } from '../consts';

const plans = [
  {
    name: 'Starter',
    color: 'mint',
    featured: false,
    description: 'For solo creators getting their first qualified leads.',
    monthly: { amount: '$9' },
    yearly: { amount: '$99', original: '$108' },
    cta: 'Start Free',
    features: [
      'Collect leads',
      'Inbound.click branding',
      'Basic lead capture (name, email, phone)',
      '4 themes',
      'Auto-generated link',
    ],
  },
  {
    name: 'Pro',
    color: 'coral',
    featured: true,
    badge: 'Most popular',
    description: 'For operators who need better conversion workflows and control.',
    monthly: { amount: '$19' },
    yearly: { amount: '$178', original: '$228' },
    cta: 'Start Free',
    features: [
      { text: 'Instant notifications', info: 'Get pinged the moment a lead comes in.' },
      'Analytics',
      'Export leads',
      'Premium themes',
      'Advanced lead capture flows',
      'Full color customization',
      'No Inbound branding',
      'Integrations',
      { text: 'Custom link', info: 'Use your own domain for your capture page.' },
    ],
  },
  {
    name: 'Team',
    color: 'yellow',
    featured: false,
    badge: 'Custom pricing',
    description: 'Custom pricing for teams and agencies that need a shared setup.',
    custom: true,
    customLabel: 'For teams and agencies',
    cta: 'Start Free',
    features: ['Everything in Pro plan', 'Priority support', 'Better AI models', 'Multiple profiles'],
  },
];
---

<section class="section" id="pricing">
  <div class="container">
    <p class="eyebrow">Pricing</p>
    <h2 class="section-title">Start free. Upgrade when the leads roll in.</h2>
    <p class="section-lede">
      Every plan includes the conversational capture experience your followers
      will actually finish.
    </p>

    <div class="billing-row">
      <div class="billing-toggle" role="group" aria-label="Billing period">
        <button type="button" class="toggle-btn" data-period-btn="yearly" aria-pressed="true">
          Yearly
        </button>
        <button type="button" class="toggle-btn" data-period-btn="monthly" aria-pressed="false">
          Monthly
        </button>
      </div>
      <p class="billing-savings">Save up to 22% with annual billing.</p>
    </div>

    <div class="plans" data-active-period="yearly">
      {
        plans.map((plan) => (
          <article class={`plan plan-${plan.color} ${plan.featured ? 'featured' : ''}`}>
            {plan.badge && (
              <span class={`badge ${plan.featured ? 'badge-coral' : 'badge-neutral'}`}>
                {plan.badge}
              </span>
            )}
            <h3>{plan.name}</h3>
            <p class="description">{plan.description}</p>

            {plan.custom ? (
              <p class="price">
                <span class="amount">Custom</span>
              </p>
            ) : (
              <p class="price">
                <span class="price-period" data-period="monthly">
                  <span class="amount">{plan.monthly?.amount}</span>
                  <span class="period">/mo</span>
                </span>
                <span class="price-period price-period-yearly" data-period="yearly">
                  {plan.yearly?.original && <span class="original">{plan.yearly.original}</span>}
                  <span class="price-main">
                    <span class="amount">{plan.yearly?.amount}</span>
                    <span class="period">/yr</span>
                  </span>
                </span>
              </p>
            )}
            {plan.custom && <p class="custom-label">{plan.customLabel}</p>}

            <a
              href={APP_SIGNIN_URL}
              class={`btn ${plan.featured ? 'btn-coral' : 'btn-secondary'} plan-cta`}
            >
              {plan.cta}
            </a>
            <ul>
              {plan.features.map((feature) => {
                const label = typeof feature === 'string' ? feature : feature.text;
                const info = typeof feature === 'string' ? null : feature.info;
                return (
                  <li>
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m4 12.5 5.5 5.5L20 6.5" />
                    </svg>
                    <span>{label}</span>
                    {info && (
                      <span class="info-icon" tabindex="0" title={info} aria-label={info}>
                        i
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .billing-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .billing-toggle {
    display: inline-flex;
    background: var(--white);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: var(--radius-pill);
    padding: 0.25rem;
  }

  .toggle-btn {
    border: none;
    background: transparent;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .toggle-btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--cream);
  }

  .billing-savings {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .plan {
    position: relative;
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    display: flex;
    flex-direction: column;
  }

  .plan.featured {
    border: 2px solid var(--coral);
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--coral) 25%, transparent);
  }

  .badge {
    position: absolute;
    top: -0.875rem;
    left: 2rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
  }

  .badge-coral {
    background: var(--coral);
    color: var(--white);
  }

  .badge-neutral {
    background: var(--ink);
    color: var(--cream);
  }

  .plan h3 {
    font-size: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .plan h3::before {
    content: '';
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
  }

  .plan-mint h3::before {
    background: var(--mint);
  }

  .plan-coral h3::before {
    background: var(--coral);
  }

  .plan-yellow h3::before {
    background: var(--yellow);
  }

  .description {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 1rem;
    min-height: 3em;
  }

  .price {
    margin-top: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 3.25rem;
  }

  .price-period {
    display: none;
    align-items: baseline;
    gap: 0.5rem;
  }

  .price-period-yearly {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
  }

  .price-main {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .plans[data-active-period='monthly'] .price-period[data-period='monthly'] {
    display: flex;
  }

  .plans[data-active-period='yearly'] .price-period[data-period='yearly'] {
    display: flex;
  }

  .original {
    font-size: 1.0625rem;
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--ink-soft) 60%, transparent);
  }

  .amount {
    font-family: var(--font-display);
    font-size: 3.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .period {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .custom-label {
    margin-top: 0.25rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .plan-cta {
    margin-top: 2rem;
    width: 100%;
  }

  .plan ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 1.75rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
  }

  .plan li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.9375rem;
  }

  .plan li svg {
    flex-shrink: 0;
    margin-top: 0.2em;
  }

  .plan-mint li svg {
    color: var(--mint-deep);
  }

  .plan-coral li svg {
    color: var(--coral);
  }

  .plan-yellow li svg {
    color: #c99a1e;
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    color: var(--ink-soft);
    font-size: 0.6875rem;
    font-style: italic;
    font-family: Georgia, serif;
    cursor: help;
    margin-top: 0.05em;
  }

  @media (max-width: 900px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
  }
</style>

<script>
  const plansEl = document.querySelector('.plans');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-period-btn]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.dataset.periodBtn;
      if (!period || !plansEl) return;

      plansEl.setAttribute('data-active-period', period);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    });
  });
</script>
