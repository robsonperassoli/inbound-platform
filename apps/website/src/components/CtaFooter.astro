---
import { APP_SIGNIN_URL } from '../consts';

const year = new Date().getFullYear();
---

<section class="section cta">
  <div class="container cta-inner">
    <h2>Your followers are ready.<br />Give them somewhere to land.</h2>
    <p>
      Claim your Inbound.click link in under a minute and let the AI build your
      first capture flow.
    </p>
    <a href={APP_SIGNIN_URL} class="btn btn-primary">Get started free</a>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <img src="/logo.svg" alt="Inbound.click" width="150" height="21" class="footer-logo" />
    <nav aria-label="Footer">
      <a href="/#how-it-works">How it works</a>
      <a href="/#features">Features</a>
      <a href="/#pricing">Pricing</a>
      <a href="/#contact">Contact</a>
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
    </nav>
    <p>&copy; {year} Inbound.click</p>
  </div>
</footer>

<style>
  .cta {
    background: linear-gradient(
      135deg,
      var(--coral) 0%,
      var(--yellow) 55%,
      var(--mint) 100%
    );
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta h2 {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 700;
  }

  .cta p {
    margin-top: 1.5rem;
    font-size: 1.1875rem;
    max-width: 42ch;
    color: color-mix(in srgb, var(--ink) 78%, transparent);
  }

  .cta .btn {
    margin-top: 2.25rem;
  }

  .footer {
    background: var(--ink);
    color: color-mix(in srgb, var(--cream) 60%, transparent);
    padding-block: 2.5rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    font-size: 0.9375rem;
  }

  .footer-logo {
    height: 18px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer nav {
    display: flex;
    gap: 1.75rem;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--cream);
  }
</style>
